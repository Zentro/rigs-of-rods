// NiceMetal: compatibility placeholders.
// These programs used to be Cg shaders. Cg is no longer supported, but mods still reference them by name
// (vertex_program_ref NiceMetal_VS ...). The names must exist: OGRE silently drops references to programs that
// don't, and the materials then render wrong (e.g. see-through). Declared with OGRE's "null" language they are
// valid but never runnable, so RoR's Cg rescue (RTSSManager::RescueMaterial) gives those materials a plain
// textured fallback. "source" is required by the script parser and never read.

vertex_program NiceMetal_VS null
{
    source none
}

fragment_program NiceMetal_PS null
{
    source none
}

fragment_program NiceMetal_transp_PS null
{
    source none
}

fragment_program NiceMetal_PS_nodmg null
{
    source none
}

fragment_program NiceMetal_transp_PS_nodmg null
{
    source none
}

vertex_program NiceMetal_Reflect_VS null
{
    source none
}

fragment_program NiceMetal_Reflect_PS null
{
    source none
}

fragment_program NiceMetal_Reflect_nocolor_PS null
{
    source none
}

fragment_program SimpleMetal_PS null
{
    source none
}

fragment_program SimpleMetal_transp_PS null
{
    source none
}
