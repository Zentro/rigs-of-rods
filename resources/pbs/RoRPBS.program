// RoR PBR helper programs (see GfxPbrMaps.cpp). Surface shading itself is generated by RTSS.

// Sampler units are set by GfxPbrMaps: on GL3+ the shader binds them itself and these parameters don't exist.
fragment_program RoR/PBS/SpecToMR_FP glsl glsles hlsl
{
    source SpecToMR_fs.glsl
}

// Environment map filtering (image based lighting)
fragment_program RoR/PBS/EnvDownsample_FP glsl glsles hlsl
{
    source EnvFilter_fs.glsl
}

fragment_program RoR/PBS/EnvPrefilter_FP glsl glsles hlsl
{
    source EnvFilter_fs.glsl
    preprocessor_defines PREFILTER
}
