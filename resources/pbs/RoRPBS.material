// RoR PBR helper materials (see GfxPbrMaps.cpp).

// Renders a legacy specular map into a metal/roughness texture (fullscreen quad, private scene)
material RoR/PBS/SpecToMR
{
    technique
    {
        pass
        {
            depth_check off
            depth_write off
            cull_hardware none
            lighting off
            vertex_program_ref RoR/Pipeline/Quad_VP
            {
            }
            fragment_program_ref RoR/PBS/SpecToMR_FP
            {
            }
            texture_unit SpecMap
            {
                tex_address_mode wrap
                filtering bilinear
            }
        }
    }
}

// Environment map filtering for image based lighting: a face of a downsample-chain level, or of a prefiltered level
material RoR/PBS/EnvDownsample
{
    technique
    {
        pass
        {
            depth_check off
            depth_write off
            cull_hardware none
            lighting off
            vertex_program_ref RoR/Pipeline/Quad_VP
            {
            }
            fragment_program_ref RoR/PBS/EnvDownsample_FP
            {
            }
            texture_unit Source
            {
                tex_address_mode clamp
                filtering bilinear
            }
        }
    }
}

material RoR/PBS/EnvPrefilter
{
    technique
    {
        pass
        {
            depth_check off
            depth_write off
            cull_hardware none
            lighting off
            vertex_program_ref RoR/Pipeline/Quad_VP
            {
            }
            fragment_program_ref RoR/PBS/EnvPrefilter_FP
            {
            }
            texture_unit Source
            {
                tex_address_mode clamp
                filtering bilinear
            }
        }
    }
}
