// HDR pipeline (gfx_render_pipeline = PBR), see GfxPipeline.cpp.
// The scene renders into a linear half-float target; the output pass tonemaps it for the display.
// Post effects (bloom, AO, ...) will hook in between, see ROADMAP.md M8.

compositor RoR/HDR
{
    technique
    {
        texture scene target_width target_height PF_FLOAT16_RGBA

        target scene
        {
            input previous
        }

        target_output
        {
            input none
            pass render_quad
            {
                material RoR/Pipeline/Tonemap
                input 0 scene
                identifier 1
            }
        }
    }
}
