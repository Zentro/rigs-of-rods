// HDR pipeline materials (see GfxPipeline.cpp)

// Output pass of the 'RoR/HDR' compositor: linear HDR scene -> exposure, tonemapping, sRGB, dither.
// The compositor renders a copy of this material; GfxPipeline sets its constants every frame.
material RoR/Pipeline/Tonemap
{
    technique
    {
        pass
        {
            depth_check off
            depth_write off
            cull_hardware none
            lighting off
            vertex_program_ref RoR/Pipeline/Quad_VP
            {
            }
            fragment_program_ref RoR/Pipeline/Tonemap_FP
            {
            }
            texture_unit
            {
                tex_address_mode clamp
                filtering none
            }
        }
    }
}
