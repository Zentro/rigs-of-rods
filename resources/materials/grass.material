//  old
material grass
{
	//transparency_casts_shadows off
	receive_shadows on
	technique
	{
		pass
		{
			//ambient 0.9 0.9 0.9 1
			//diffuse 0.7 0.7 0.7 1
			//specular 0.5 0.5 0.5 1 32
			lighting off
	
			cull_hardware none
			//cull_software none

			scene_blend alpha_blend
			alpha_rejection greater_equal 128
			//transparency_casts_shadows off
			//depth_write off
			
			texture_unit
			{
				texture grass1.png
			}
		}
	}
}

//--------------------------------------------------------------------------------
//  grass shadowed pssm
vertex_program grassVP null
{
    source none
} 

fragment_program grassFP null
{
    source none
}


//  grass
//material grass_GrassVS_anim_1_0_40_vp
material grass_GrassVS_
{
	receive_shadows on
	technique
	{
		pass
		{
			lighting off
	
			cull_hardware none
			//cull_software none

			scene_blend alpha_blend
			alpha_rejection greater_equal 128
			//transparency_casts_shadows off
			//depth_write off
			
			vertex_program_ref   grassVP { }
			fragment_program_ref grassFP { }

			texture_unit diffuseMap
			{
				texture grass1.png
			}

			texture_unit shadow_tex0
			{
				content_type shadow
				tex_address_mode clamp
			}
			texture_unit shadow_tex1
			{
				content_type shadow
				tex_address_mode clamp
			}
			texture_unit shadow_tex2
			{
				content_type shadow
				tex_address_mode clamp
			}
		}
	}
}