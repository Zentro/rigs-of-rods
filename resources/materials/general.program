// Compatibility placeholders: these programs used to be Cg shaders. The names stay for mods that reference them;
// declared with OGRE's "null" language they are never runnable, so RoR's Cg rescue gives the materials a fallback.
//  ambient
vertex_program ambient_vs null
{
    source none
}
 
fragment_program ambient_ps null
{
    source none
}


//  render
//--------------------------------------------------------------------------------------------------
vertex_program render_vs null
{
    source none
}
 
fragment_program render_ps null
{
    source none
}

fragment_program render_gr_ps null
{
    source none
}


//  diffuse
//--------------------------------------------------------------------------------------------------
vertex_program diffuse_vs null
{
    source none
}
 
fragment_program diffuse_ps null
{
    source none
}


//  env reflect
fragment_program diffuse_ps_env null
{
    source none
}


//  shadows
//--------------------------------------------------------------------------------------------------
vertex_program diffuse_sh_vs null
{
    source none
}
 
fragment_program diffuse_sh_ps null
{
    source none
}
 
fragment_program diffuse_sh_a_ps null
{
    source none
}
