//----------------------------
// Distortion effects (OGRE 14.6 sample shaders: Example_FresnelVp.glsl / Example_FresnelFp.glsl)
//----------------------------

vertex_program Examples/FresnelRefractReflectVP glsl glsles glslang hlsl
{
	source Example_FresnelVp.glsl
}

fragment_program Examples/FresnelRefractReflectFP glsl glsles glslang hlsl
{
	source Example_FresnelFp.glsl
	default_params
	{
		param_named noiseMap int 0
		param_named reflectMap int 1
		param_named refractMap int 2
	}
}

fragment_program Examples/ReflectFP glsl glsles glslang hlsl
{
	source Example_ReflectFp.glsl
	default_params
	{
		param_named noiseMap int 0
		param_named reflectMap int 1
	}
}

material Examples/FresnelReflectionRefraction
{
	receive_shadows off
	technique
	{
		pass
		{
			cull_hardware none
			vertex_program_ref Examples/FresnelRefractReflectVP
			{
				param_named_auto worldViewProjMatrix worldviewproj_matrix
				param_named_auto textureProjMatrix texture_worldviewproj_matrix 0
				param_named_auto eyePosition camera_position_object_space
				param_named_auto timeVal time 0.05
				param_named scroll float 1.0
				param_named scale float 4.0
				param_named noise float 1.0
			}
			fragment_program_ref Examples/FresnelRefractReflectFP
			{
				param_named fresnelBias float -0.3
				param_named fresnelScale float 1.4
				param_named fresnelPower float 8.0
				param_named tintColour float4 0.05 0.12 0.15 1.0
				param_named noiseScale float 0.05
			}
			// Noise; unit 0 is also the projector for textureProjMatrix (projective texturing set in GfxWater)
			texture_unit
			{
				texture waves2.dds
				filtering linear linear none
			}
			// Reflection
			texture_unit
			{
				// Will be filled in at runtime
				texture Reflection
				tex_address_mode clamp
			}
			// Refraction
			texture_unit
			{
				// Will be filled in at runtime
				texture Refraction
				tex_address_mode clamp
			}
		}
	}
}

